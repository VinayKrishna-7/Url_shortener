# ==========================================
# ZapLink - Environment Configuration Example
# ==========================================

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Authentication Secret
NEXTAUTH_SECRET="your_nextauth_jwt_secret_key_change_in_production"

# Designated Authorized Admin Email (Only this email gets ADMIN privileges)
ADMIN_EMAIL="admin@zaplink.app"

# Database Connection (SQLite default for zero-config run, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Redis Cache & Rate Limiting (Optional - automatically falls back to in-memory LRU cache)
REDIS_URL="redis://localhost:6379"

# Privacy & Security (Salt used for hashing IP addresses for GDPR compliance)
IP_SALT="your_privacy_ip_salt_string_change_in_production"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
